{
  "name": "ldes-server",
  "version": "1.0.0-alpha.1",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "config"
  ],
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/ldes-server",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/ldes-server/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/ldes-server/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/ldes-server/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/ldes-server/^0.0.0/dist/": "dist/"
  },
  "scripts": {
    "start": "npx community-solid-server -c ./server/examples/config-ldes.json -f ./data",
    "test": "vitest run --coverage --coverage.include src",
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc",
    "live": "tsc -w",
    "build:components": "componentsjs-generator -s src -c dist/components -i .componentsignore -r lss",
    "prepublishOnly": "npm run build"
  },
  "peerDependency": {
    "@solid/community-server": "8.x"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "@treecg/types": "^0.4.6",
    "member-extraction-algorithm": "^0.0.1",
    "mongodb": "^7.1.1",
    "n3": "^2.0.3",
    "rdf-data-factory": "^2.0.2",
    "rdf-stores": "^2.2.0",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@solid/community-server": "^8.0.0-alpha.3",
    "@tsconfig/node18": "^18.2.6",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.1",
    "componentsjs-generator": "^4.3.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
